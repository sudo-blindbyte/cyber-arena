<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="CyberArenaWebForms.AdminMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>
        <asp:ContentPlaceHolder ID="TitleContent" runat="server">Admin</asp:ContentPlaceHolder>
        &#8212; CyberArena Admin
    </title>

    <!-- ── Google Fonts ──────────────────────────────────────── -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap"
          rel="stylesheet" />

    <!-- ── Font Awesome 6 ───────────────────────────────────── -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
          integrity="sha512-Avb2QiuDEEvB4bZJYdft2mNjVShBftLdPG8FJ0V7irTLQ8Uo0qcPxh4Plq7G5tGm0rU+1SPhVotteLpBERwTkw=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- ── Bootstrap 5 (CDN to match _AdminLayout) ──────────── -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />

    <!-- ── Admin Panel Styles ────────────────────────────────── -->
    <link rel="stylesheet" href="<%= ResolveUrl("~/CSS/admin-panel.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/CSS/part3.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/CSS/challenges.css") %>" />

    <!-- ── Per-page extra styles ────────────────────────────── -->
    <asp:ContentPlaceHolder ID="HeadStyles" runat="server" />
</head>
<body class="adm-body">

    <form id="AdminForm" runat="server">

    <!-- ══════════════════════════════════════════════════════════
         ADMIN SIDEBAR
    ══════════════════════════════════════════════════════════ -->
    <aside class="adm-sidebar" id="adm-sidebar" aria-label="Admin navigation">

        <!-- Brand -->
        <a class="adm-sidebar-brand"
           href="<%= ResolveUrl("~/Admin/AdminDashboard.aspx") %>"
           aria-label="Admin Dashboard">
            <div class="adm-sidebar-brand-icon" aria-hidden="true">
                <i class="fas fa-shield-halved"></i>
            </div>
            <div class="adm-sidebar-brand-text">
                <span class="adm-sidebar-brand-name">CyberArena</span>
                <span class="adm-sidebar-brand-tag">Admin Panel</span>
            </div>
        </a>

        <!-- Navigation -->
        <nav class="adm-sidebar-nav" aria-label="Admin navigation">

            <div class="adm-nav-section">Overview</div>

            <a class="<%= AdmNav("AdminDashboard") %>"
               href="<%= ResolveUrl("~/Admin/AdminDashboard.aspx") %>"
               id="adm-nav-dashboard">
                <span class="adm-nav-icon" aria-hidden="true"><i class="fas fa-gauge-high"></i></span>
                Dashboard
            </a>

            <a class="<%= AdmNav("Reports") %>"
               href="<%= ResolveUrl("~/Admin/Reports.aspx") %>"
               id="adm-nav-reports">
                <span class="adm-nav-icon" aria-hidden="true"><i class="fas fa-chart-bar"></i></span>
                Reports
            </a>

            <div class="adm-nav-section">Content</div>

            <a class="<%= AdmNav("ManageChallenges") %>"
               href="<%= ResolveUrl("~/Admin/Challenges/ManageChallenges.aspx") %>"
               id="adm-nav-challenges">
                <span class="adm-nav-icon" aria-hidden="true"><i class="fas fa-flag"></i></span>
                Manage Challenges
            </a>

            <a class="<%= AdmNav("ChallengeForm") %>"
               href="<%= ResolveUrl("~/Admin/Challenges/ChallengeForm.aspx") %>"
               id="adm-nav-new-challenge">
                <span class="adm-nav-icon" aria-hidden="true"><i class="fas fa-plus-circle"></i></span>
                New Challenge
            </a>

            <a class="<%= AdmNav("ManageAnnouncements") %>"
               href="<%= ResolveUrl("~/Admin/Announcements/ManageAnnouncements.aspx") %>"
               id="adm-nav-announcements">
                <span class="adm-nav-icon" aria-hidden="true"><i class="fas fa-bullhorn"></i></span>
                Announcements
            </a>

            <div class="adm-nav-section">Participants</div>

            <a class="<%= AdmNav("Leaderboard") %>"
               href="<%= ResolveUrl("~/Leaderboard/Leaderboard.aspx") %>"
               id="adm-nav-leaderboard"
               target="_blank"
               title="Opens in user panel">
                <span class="adm-nav-icon" aria-hidden="true"><i class="fas fa-trophy"></i></span>
                Leaderboard
                <i class="fas fa-arrow-up-right-from-square ms-auto"
                   style="font-size:0.65rem;opacity:0.5;" aria-hidden="true"></i>
            </a>

            <a class="<%= AdmNav("Competitions") %>"
               href="<%= ResolveUrl("~/Competitions/Competitions.aspx") %>"
               id="adm-nav-competitions"
               target="_blank"
               title="Opens in user panel">
                <span class="adm-nav-icon" aria-hidden="true"><i class="fas fa-bolt"></i></span>
                Competitions
                <i class="fas fa-arrow-up-right-from-square ms-auto"
                   style="font-size:0.65rem;opacity:0.5;" aria-hidden="true"></i>
            </a>

        </nav>

        <!-- Admin footer chip -->
        <div class="adm-sidebar-footer">
            <div class="adm-admin-chip">
                <div class="adm-admin-avatar" aria-hidden="true">A</div>
                <div style="flex:1;min-width:0;">
                    <div class="adm-admin-name"><%= GetAdminUsername() %></div>
                    <div class="adm-admin-role">Administrator</div>
                </div>
            </div>
        </div>

    </aside>

    <!-- ══════════════════════════════════════════════════════════
         ADMIN TOPBAR
    ══════════════════════════════════════════════════════════ -->
    <header class="adm-topbar" id="adm-topbar">
        <div class="adm-topbar-breadcrumb">
            <i class="fas fa-shield-halved" style="color:#EF4444;" aria-hidden="true"></i>
            <strong>
                <asp:Literal ID="litBreadcrumb" runat="server" Text="Admin" />
            </strong>
        </div>
        <div class="adm-topbar-right">
            <span class="adm-badge">
                <i class="fas fa-circle" style="font-size:0.45rem;" aria-hidden="true"></i>
                Admin Session
            </span>

            <!-- Admin Logout button — posts to AdminLogin.aspx with logout action -->
            <asp:Button ID="btnAdminLogout"
                        runat="server"
                        Text="Sign Out"
                        CssClass="adm-logout-btn"
                        ID="btn-adm-logout"
                        OnClick="btnAdminLogout_Click"
                        title="Sign out of Admin Panel"
                        UseSubmitBehavior="true">
            </asp:Button>
        </div>
    </header>

    <!-- ══════════════════════════════════════════════════════════
         ADMIN MAIN CONTENT
    ══════════════════════════════════════════════════════════ -->
    <main class="adm-main" id="adm-main">

        <!-- Toast: Admin success message (replaces TempData["AdminSuccess"]) -->
        <asp:Panel ID="pnlAdminToast" runat="server" Visible="false"
                   CssClass="adm-toast"
                   role="status" aria-live="polite">
            <i class="fas fa-circle-check" style="color:#10B981;font-size:1rem;" aria-hidden="true"></i>
            <asp:Literal ID="litAdminSuccess" runat="server" />
        </asp:Panel>

        <!-- ═══ PAGE-SPECIFIC CONTENT ═══ -->
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />

    </main>

    </form>

    <!-- ── Bootstrap 5 JS (CDN, matching the original admin layout) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jl73RqW9Ck703PokG/gy84WaD1OWu"
            crossorigin="anonymous"></script>

    <!-- ── Admin inline scripts (ported from _AdminLayout) ─────── -->
    <script>
    (function () {
        // Auto-dismiss admin toast after 4 seconds
        var toast = document.getElementById('<%=pnlAdminToast.ClientID%>');
        if (toast) {
            setTimeout(function () {
                toast.style.transition = 'opacity 0.4s';
                toast.style.opacity    = '0';
                setTimeout(function () { toast.style.display = 'none'; }, 400);
            }, 4000);
        }

        // Animate progress bars
        document.querySelectorAll('.ca-progress-bar[data-width]').forEach(function (bar) {
            var w = parseInt(bar.dataset.width, 10);
            setTimeout(function () {
                bar.style.transition = 'width 0.8s ease';
                bar.style.width      = w + '%';
            }, 200);
        });

        // Counter animations
        document.querySelectorAll('[data-count]').forEach(function (el) {
            var target = parseInt(el.dataset.count, 10);
            var start  = 0;
            var dur    = 900;
            var step   = Math.ceil(target / (dur / 16));
            var timer  = setInterval(function () {
                start += step;
                if (start >= target) { start = target; clearInterval(timer); }
                el.textContent = start.toLocaleString();
            }, 16);
        });
    }());
    </script>

    <!-- Per-page scripts -->
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />

</body>
</html>
