@model TeamCreateViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Create Team";
}

@section Styles {
    <link rel="stylesheet" href="~/css/part3.css" asp-append-version="true" />
}

<div class="stagger-children">

    <div class="p3-page-header">
        <div>
            <h2 class="p3-page-title">
                <i class="fas fa-users" style="color:var(--ca-accent);" aria-hidden="true"></i>
                Create Team
            </h2>
            <p class="p3-page-subtitle">Assemble your crew and dominate the leaderboard</p>
        </div>
        <a asp-controller="Teams" asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1" aria-hidden="true"></i>Back to Teams
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-7">
            <div class="ca-card">
                <div class="ca-card-header">
                    <div>
                        <h3 class="ca-card-title">Team Details</h3>
                        <div class="ca-card-subtitle">You will automatically become the team captain</div>
                    </div>
                    <i class="fas fa-shield-halved" style="color:var(--ca-accent);font-size:1.3rem;" aria-hidden="true"></i>
                </div>

                <form asp-controller="Teams" asp-action="Create" method="post" data-loading>
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name"
                               class="form-control"
                               id="input-team-name"
                               placeholder="e.g. NullByte, ByteForce, PhantomByte…"
                               autocomplete="off"
                               maxlength="50" />
                        <span asp-validation-for="Name" class="field-validation-error"></span>
                        <div class="form-text" style="color:var(--ca-text-muted);font-size:0.75rem;">
                            2–50 characters. Choose something memorable.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  id="input-team-desc"
                                  rows="3"
                                  maxlength="500"
                                  placeholder="Describe your team's specialty, members, or strategy…"></textarea>
                        <span asp-validation-for="Description" class="field-validation-error"></span>
                        <div class="form-text" style="color:var(--ca-text-muted);font-size:0.75rem;">
                            Optional — up to 500 characters.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Country" class="form-label"></label>
                        <input asp-for="Country"
                               class="form-control"
                               id="input-team-country"
                               placeholder="e.g. India, United States, Germany…"
                               maxlength="100" />
                        <span asp-validation-for="Country" class="field-validation-error"></span>
                    </div>

                    @* Team preview *@
                    <div class="p-3 mb-4 rounded-3" style="background:var(--ca-bg-base);border:1px solid var(--ca-border-light);">
                        <div class="d-flex align-items-center gap-3">
                            <div class="team-avatar" id="preview-avatar" aria-hidden="true" style="width:44px;height:44px;">?</div>
                            <div>
                                <div style="font-weight:600;font-size:0.9rem;color:var(--ca-text-primary);" id="preview-name">Your Team Name</div>
                                <div style="font-size:0.75rem;color:var(--ca-text-muted);">
                                    <i class="fas fa-crown" style="color:var(--ca-warning);" aria-hidden="true"></i>
                                    Captain: h4x0r_pro · 1 member
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-controller="Teams" asp-action="Index" class="btn btn-secondary" id="btn-cancel-team">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary" id="btn-submit-team">
                            <i class="fas fa-plus me-2" aria-hidden="true"></i>Create Team
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (function () {
        var nameInput  = document.getElementById('input-team-name');
        var previewName   = document.getElementById('preview-name');
        var previewAvatar = document.getElementById('preview-avatar');

        nameInput.addEventListener('input', function () {
            var val = nameInput.value.trim();
            previewName.textContent   = val || 'Your Team Name';
            previewAvatar.textContent = val ? val[0].toUpperCase() : '?';
        });
    }());
    </script>
}
