@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<div class="ca-auth-page">
    <div class="ca-auth-left" aria-hidden="true">
        <div class="ca-auth-grid"></div>
        <a class="ca-auth-logo" asp-controller="Home" asp-action="Index">
            <div class="ca-auth-logo-icon"><i class="fas fa-shield-halved"></i></div>
            <div>
                <span class="ca-auth-logo-text">CyberArena</span>
                <span class="ca-auth-logo-sub">CTF Management Platform</span>
            </div>
        </a>
        <div class="ca-auth-brand">
            <h2 class="ca-auth-headline">
                Forgot your<br /><span>Password?</span>
            </h2>
            <p class="ca-auth-subtext">
                No worries — enter your email and we'll send you a link to
                get back into your account in seconds.
            </p>
        </div>
        <div class="ca-auth-shield" aria-hidden="true"><i class="fas fa-shield-halved"></i></div>
    </div>

    <div class="ca-auth-right">
        <div class="ca-auth-form-wrap">

            @* Back link *@
            <a asp-controller="Account" asp-action="Login"
               class="d-inline-flex align-items-center gap-2 mb-4"
               style="color:var(--ca-text-muted);font-size:0.875rem;text-decoration:none;">
                <i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Sign In
            </a>

            <div class="ca-auth-form-header">
                <h1 class="ca-auth-form-title">Reset password</h1>
                <p class="ca-auth-form-subtitle">Enter your email to receive a reset link</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-3" role="alert">
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            }

            <form asp-controller="Account" asp-action="ForgotPassword"
                  method="post" data-loading="true" novalidate>
                @Html.AntiForgeryToken()

                <div class="ca-auth-field">
                    <label asp-for="Email">Email address</label>
                    <div class="ca-input-group">
                        <span class="ca-input-icon"><i class="fas fa-envelope" aria-hidden="true"></i></span>
                        <input asp-for="Email"
                               id="fp-email"
                               class="form-control"
                               type="email"
                               placeholder="you@example.com"
                               autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="field-validation-error mt-1 d-block"></span>
                </div>

                <button type="submit" id="btn-forgot" class="ca-auth-submit">
                    <i class="fas fa-paper-plane me-2" aria-hidden="true"></i>
                    Send Reset Link
                </button>

                <p class="ca-auth-footer-text">
                    Remembered it?
                    <a asp-controller="Account" asp-action="Login">Sign in</a>
                </p>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
