@model VerifyEmailViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Verify Your Email";
}

<div class="ca-auth-page">
    <div class="ca-auth-left" aria-hidden="true">
        <div class="ca-auth-grid"></div>
        <a class="ca-auth-logo" asp-controller="Home" asp-action="Index">
            <div class="ca-auth-logo-icon"><i class="fas fa-shield-halved"></i></div>
            <div>
                <span class="ca-auth-logo-text">CyberArena</span>
                <span class="ca-auth-logo-sub">CTF Management Platform</span>
            </div>
        </a>
        <div class="ca-auth-brand">
            <h2 class="ca-auth-headline">One Last<br /><span>Step!</span></h2>
            <p class="ca-auth-subtext">Verify your email to activate your account and start competing.</p>
        </div>
        <div class="ca-auth-shield" aria-hidden="true"><i class="fas fa-shield-halved"></i></div>
    </div>

    <div class="ca-auth-right">
        <div class="ca-auth-form-wrap">

            @if (Model.IsSuccess)
            {
                @* ── Success state ── *@
                <div class="text-center">
                    <div class="ca-auth-icon-circle success mx-auto">
                        <i class="fas fa-circle-check" aria-hidden="true"></i>
                    </div>
                    <h1 class="ca-auth-form-title text-center mt-3 mb-2">Email verified!</h1>
                    <p style="color:var(--ca-text-muted);font-size:0.9rem;margin-bottom:2rem;">
                        Your account is ready. Welcome to CyberArena!
                    </p>
                    <a asp-controller="Account" asp-action="Login"
                       class="ca-auth-submit"
                       style="text-decoration:none;display:flex;align-items:center;justify-content:center;gap:0.5rem;">
                        <i class="fas fa-arrow-right-to-bracket" aria-hidden="true"></i>
                        Start Hacking
                    </a>
                </div>
            }
            else
            {
                @* ── OTP entry state ── *@
                <div class="ca-auth-form-header text-center">
                    <div class="ca-auth-icon-circle info mx-auto mb-3">
                        <i class="fas fa-envelope" aria-hidden="true"></i>
                    </div>
                    <h1 class="ca-auth-form-title text-center mb-2">Verify your email</h1>
                    <p style="color:var(--ca-text-muted);font-size:0.9rem;">
                        We sent a 6-digit code to<br />
                        <strong style="color:var(--ca-text-primary);">@(Model.Email ?? "your email")</strong>
                    </p>
                </div>

                <form asp-controller="Account" asp-action="VerifyEmail" method="post" data-loading="true">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />

                    <div class="ca-otp-wrap" role="group" aria-label="6-digit verification code">
                        @for (int i = 0; i < 6; i++)
                        {
                            <input class="ca-otp-input"
                                   type="text"
                                   maxlength="1"
                                   inputmode="numeric"
                                   pattern="[0-9]"
                                   aria-label="Digit @(i + 1)"
                                   id="otp-@i"
                                   autocomplete="@(i == 0 ? "one-time-code" : "off")" />
                        }
                    </div>

                    @* Hidden field to collect full code *@
                    <input asp-for="Code" id="otp-full-code" type="hidden" />

                    <button type="submit" id="btn-verify"
                            class="ca-auth-submit"
                            onclick="collectOtp()">
                        <i class="fas fa-circle-check me-2" aria-hidden="true"></i>
                        Verify Email
                    </button>

                    <p class="ca-auth-footer-text mt-3">
                        Didn't receive the code?
                        <a asp-controller="Account" asp-action="Register" style="color:var(--ca-accent);">Resend</a>
                    </p>
                </form>
            }

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function collectOtp() {
            var code = '';
            document.querySelectorAll('.ca-otp-input').forEach(function (inp) {
                code += inp.value;
            });
            document.getElementById('otp-full-code').value = code;
        }
    </script>
}
