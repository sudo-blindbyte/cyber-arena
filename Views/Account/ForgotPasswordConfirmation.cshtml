@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Check Your Email";
}

<div class="ca-auth-page">
    <div class="ca-auth-left" aria-hidden="true">
        <div class="ca-auth-grid"></div>
        <a class="ca-auth-logo" asp-controller="Home" asp-action="Index">
            <div class="ca-auth-logo-icon"><i class="fas fa-shield-halved"></i></div>
            <div>
                <span class="ca-auth-logo-text">CyberArena</span>
                <span class="ca-auth-logo-sub">CTF Management Platform</span>
            </div>
        </a>
        <div class="ca-auth-brand">
            <h2 class="ca-auth-headline">Email <span>Sent!</span></h2>
            <p class="ca-auth-subtext">Check your inbox for the password reset link. It expires in 15 minutes.</p>
        </div>
        <div class="ca-auth-shield" aria-hidden="true"><i class="fas fa-shield-halved"></i></div>
    </div>

    <div class="ca-auth-right">
        <div class="ca-auth-form-wrap text-center">

            <div class="ca-auth-icon-circle success mb-3 mx-auto">
                <i class="fas fa-envelope-circle-check" aria-hidden="true"></i>
            </div>

            <h1 class="ca-auth-form-title text-center mb-2">Check your email</h1>
            <p style="color:var(--ca-text-muted);font-size:0.9rem;margin-bottom:2rem;">
                We sent a password reset link to<br />
                <strong style="color:var(--ca-text-primary);">@(TempData["ForgotPasswordSent"] ?? "your email")</strong>
            </p>

            <div class="ca-card mb-3 text-start" style="background:var(--ca-bg-card);">
                <p style="font-size:0.85rem;color:var(--ca-text-secondary);margin:0;">
                    <i class="fas fa-circle-info me-2" style="color:var(--ca-accent);" aria-hidden="true"></i>
                    Didn't get the email? Check your spam folder, or
                    <a asp-controller="Account" asp-action="ForgotPassword" style="color:var(--ca-accent);">try again</a>
                    with a different address.
                </p>
            </div>

            <a asp-controller="Account" asp-action="Login"
               class="ca-auth-submit d-inline-flex align-items-center justify-content-center gap-2"
               style="text-decoration:none;display:block!important;">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                Back to Sign In
            </a>

        </div>
    </div>
</div>
