@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Password Reset";
}

<div class="ca-auth-page">
    <div class="ca-auth-left" aria-hidden="true">
        <div class="ca-auth-grid"></div>
        <a class="ca-auth-logo" asp-controller="Home" asp-action="Index">
            <div class="ca-auth-logo-icon"><i class="fas fa-shield-halved"></i></div>
            <div>
                <span class="ca-auth-logo-text">CyberArena</span>
                <span class="ca-auth-logo-sub">CTF Management Platform</span>
            </div>
        </a>
        <div class="ca-auth-brand">
            <h2 class="ca-auth-headline">Password <span>Updated!</span></h2>
            <p class="ca-auth-subtext">Your password has been changed. You can now sign in with your new credentials.</p>
        </div>
        <div class="ca-auth-shield" aria-hidden="true"><i class="fas fa-shield-halved"></i></div>
    </div>

    <div class="ca-auth-right">
        <div class="ca-auth-form-wrap text-center">
            <div class="ca-auth-icon-circle success mx-auto mb-3">
                <i class="fas fa-circle-check" aria-hidden="true"></i>
            </div>
            <h1 class="ca-auth-form-title text-center mb-2">Password reset!</h1>
            <p style="color:var(--ca-text-muted);font-size:0.9rem;margin-bottom:2rem;">
                Your password has been successfully changed.<br />
                You can now sign in with your new password.
            </p>
            <a asp-controller="Account" asp-action="Login"
               class="ca-auth-submit"
               style="text-decoration:none;display:flex;align-items:center;justify-content:center;gap:0.5rem;">
                <i class="fas fa-arrow-right-to-bracket" aria-hidden="true"></i>
                Sign In
            </a>
        </div>
    </div>
</div>
