@model ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
}

<div class="ca-auth-page">
    <div class="ca-auth-left" aria-hidden="true">
        <div class="ca-auth-grid"></div>
        <a class="ca-auth-logo" asp-controller="Home" asp-action="Index">
            <div class="ca-auth-logo-icon"><i class="fas fa-shield-halved"></i></div>
            <div>
                <span class="ca-auth-logo-text">CyberArena</span>
                <span class="ca-auth-logo-sub">CTF Management Platform</span>
            </div>
        </a>
        <div class="ca-auth-brand">
            <h2 class="ca-auth-headline">Set a New<br /><span>Password</span></h2>
            <p class="ca-auth-subtext">Choose a strong password to keep your account secure.</p>
        </div>
        <div class="ca-auth-shield" aria-hidden="true"><i class="fas fa-shield-halved"></i></div>
    </div>

    <div class="ca-auth-right">
        <div class="ca-auth-form-wrap">

            <div class="ca-auth-form-header">
                <h1 class="ca-auth-form-title">New password</h1>
                <p class="ca-auth-form-subtitle">Must be at least 8 characters</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-3" role="alert">
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            }

            <form asp-controller="Account" asp-action="ResetPassword"
                  method="post" data-loading="true" novalidate>
                @Html.AntiForgeryToken()

                @* Hidden fields *@
                <input asp-for="Token" type="hidden" />
                <input asp-for="Email" type="hidden" />

                @* New Password *@
                <div class="ca-auth-field">
                    <label asp-for="Password">New password</label>
                    <div class="ca-input-group">
                        <span class="ca-input-icon"><i class="fas fa-lock" aria-hidden="true"></i></span>
                        <input asp-for="Password"
                               id="rp-password"
                               class="form-control"
                               type="password"
                               placeholder="Min. 8 characters"
                               autocomplete="new-password"
                               data-pwd-strength="rp-strength-meter" />
                        <button class="ca-pwd-toggle" type="button" data-target="rp-password" aria-label="Show/hide password">
                            <i class="fas fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="ca-pwd-strength mt-2" id="rp-strength-meter" aria-live="polite">
                        <div class="ca-pwd-strength-bar" aria-hidden="true"></div>
                        <div class="ca-pwd-strength-bar" aria-hidden="true"></div>
                        <div class="ca-pwd-strength-bar" aria-hidden="true"></div>
                        <div class="ca-pwd-strength-bar" aria-hidden="true"></div>
                        <span class="ca-pwd-strength-label"></span>
                    </div>
                    <span asp-validation-for="Password" class="field-validation-error mt-1 d-block"></span>
                </div>

                @* Confirm Password *@
                <div class="ca-auth-field">
                    <label asp-for="ConfirmPassword">Confirm new password</label>
                    <div class="ca-input-group">
                        <span class="ca-input-icon"><i class="fas fa-lock-open" aria-hidden="true"></i></span>
                        <input asp-for="ConfirmPassword"
                               id="rp-confirm"
                               class="form-control"
                               type="password"
                               placeholder="Repeat new password"
                               autocomplete="new-password" />
                        <button class="ca-pwd-toggle" type="button" data-target="rp-confirm" aria-label="Show/hide password">
                            <i class="fas fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error mt-1 d-block"></span>
                </div>

                <button type="submit" id="btn-reset" class="ca-auth-submit">
                    <i class="fas fa-key me-2" aria-hidden="true"></i>
                    Reset Password
                </button>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
