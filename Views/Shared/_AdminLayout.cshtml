@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLower() ?? "";
    var currentAction     = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower() ?? "";
    var adminUser         = Context.Session.GetString("AdminUsername") ?? "admin";
    var breadcrumb        = ViewData["Breadcrumb"] as string ?? ViewData["Title"] as string ?? "Admin";

    string AdmNav(string controller, string? action = null)
    {
        bool match = currentController == controller.ToLower()
            && (action == null || currentAction == action.ToLower());
        return match ? "adm-nav-link active" : "adm-nav-link";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — CyberArena Admin</title>
    <meta name="robots" content="noindex, nofollow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
          integrity="sha512-Avb2QiuDEEvB4bZJYdft2mNjVShBftLdPG8FJ0V7irTLQ8Uo0qcPxh4Plh7eecOVud5M0vVxW7gSB4bOqfyvA=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    @* Bootstrap *@
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />

    @* Admin panel CSS *@
    <link rel="stylesheet" href="~/css/admin-panel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/part3.css"       asp-append-version="true" />
    <link rel="stylesheet" href="~/css/challenges.css"  asp-append-version="true" />

    @* Page-specific styles *@
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="adm-body">

    @* ══════════════════════════════════════════════════════════
       ADMIN SIDEBAR
    ══════════════════════════════════════════════════════════ *@
    <aside class="adm-sidebar" id="adm-sidebar" aria-label="Admin navigation">

        @* Brand *@
        <a class="adm-sidebar-brand" asp-controller="Admin" asp-action="Index" aria-label="Admin Dashboard">
            <div class="adm-sidebar-brand-icon" aria-hidden="true">
                <i class="fas fa-shield-halved"></i>
            </div>
            <div class="adm-sidebar-brand-text">
                <span class="adm-sidebar-brand-name">CyberArena</span>
                <span class="adm-sidebar-brand-tag">Admin Panel</span>
            </div>
        </a>

        @* Navigation *@
        <nav class="adm-sidebar-nav" aria-label="Admin navigation">

            <div class="adm-nav-section">Overview</div>

            <a class="@AdmNav("admin", "index")"
               asp-controller="Admin" asp-action="Index"
               id="adm-nav-dashboard">
                <span class="adm-nav-icon" aria-hidden="true"><i class="fas fa-gauge-high"></i></span>
                Dashboard
            </a>

            <a class="@AdmNav("admin", "reports")"
               asp-controller="Admin" asp-action="Reports"
               id="adm-nav-reports">
                <span class="adm-nav-icon" aria-hidden="true"><i class="fas fa-chart-bar"></i></span>
                Reports
            </a>

            <div class="adm-nav-section">Content</div>

            <a class="@AdmNav("admin", "challenges")"
               asp-controller="Admin" asp-action="Challenges"
               id="adm-nav-challenges">
                <span class="adm-nav-icon" aria-hidden="true"><i class="fas fa-flag"></i></span>
                Manage Challenges
            </a>

            <a class="@AdmNav("admin", "challengecreate")"
               asp-controller="Admin" asp-action="ChallengeCreate"
               id="adm-nav-new-challenge">
                <span class="adm-nav-icon" aria-hidden="true"><i class="fas fa-plus-circle"></i></span>
                New Challenge
            </a>

            <a class="@AdmNav("admin", "announcements")"
               asp-controller="Admin" asp-action="Announcements"
               id="adm-nav-announcements">
                <span class="adm-nav-icon" aria-hidden="true"><i class="fas fa-bullhorn"></i></span>
                Announcements
            </a>

            <div class="adm-nav-section">Participants</div>

            <a class="@AdmNav("leaderboard")"
               asp-controller="Leaderboard" asp-action="Index"
               id="adm-nav-leaderboard" target="_blank"
               title="Opens in the user panel">
                <span class="adm-nav-icon" aria-hidden="true"><i class="fas fa-trophy"></i></span>
                Leaderboard
                <i class="fas fa-arrow-up-right-from-square ms-auto" style="font-size:0.65rem;opacity:0.5;" aria-hidden="true"></i>
            </a>

            <a class="@AdmNav("competitions")"
               asp-controller="Competitions" asp-action="Index"
               id="adm-nav-competitions" target="_blank"
               title="Opens in the user panel">
                <span class="adm-nav-icon" aria-hidden="true"><i class="fas fa-bolt"></i></span>
                Competitions
                <i class="fas fa-arrow-up-right-from-square ms-auto" style="font-size:0.65rem;opacity:0.5;" aria-hidden="true"></i>
            </a>

        </nav>

        @* Admin footer chip *@
        <div class="adm-sidebar-footer">
            <div class="adm-admin-chip">
                <div class="adm-admin-avatar" aria-hidden="true">A</div>
                <div style="flex:1;min-width:0;">
                    <div class="adm-admin-name">@adminUser</div>
                    <div class="adm-admin-role">Administrator</div>
                </div>
            </div>
        </div>

    </aside>

    @* ══════════════════════════════════════════════════════════
       ADMIN TOPBAR
    ══════════════════════════════════════════════════════════ *@
    <header class="adm-topbar" id="adm-topbar">
        <div class="adm-topbar-breadcrumb">
            <i class="fas fa-shield-halved" style="color:#EF4444;" aria-hidden="true"></i>
            <strong>@breadcrumb</strong>
        </div>
        <div class="adm-topbar-right">
            <span class="adm-badge">
                <i class="fas fa-circle" style="font-size:0.45rem;" aria-hidden="true"></i>
                Admin Session
            </span>
            <form asp-controller="AdminLogin" asp-action="Logout" method="post" class="d-inline"
                  id="adm-logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="adm-logout-btn" id="btn-adm-logout"
                        title="Sign out of Admin Panel">
                    <i class="fas fa-right-from-bracket" aria-hidden="true"></i>
                    Sign Out
                </button>
            </form>
        </div>
    </header>

    @* ══════════════════════════════════════════════════════════
       MAIN CONTENT
    ══════════════════════════════════════════════════════════ *@
    <main class="adm-main" id="adm-main">

        @* TempData success toast *@
        @if (TempData["AdminSuccess"] != null)
        {
            <div class="adm-toast" id="adm-toast" role="status" aria-live="polite">
                <i class="fas fa-circle-check" style="color:#10B981;font-size:1rem;" aria-hidden="true"></i>
                @TempData["AdminSuccess"]
            </div>
        }

        @RenderBody()
    </main>

    @* Bootstrap JS *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jl73RqW9Ck703PokG/gy84WaD1OWu"
            crossorigin="anonymous"></script>

    <script>
    // Auto-dismiss toast after 4 seconds
    (function () {
        var toast = document.getElementById('adm-toast');
        if (toast) {
            setTimeout(function () {
                toast.style.transition = 'opacity 0.4s';
                toast.style.opacity    = '0';
                setTimeout(function () { toast.remove(); }, 400);
            }, 4000);
        }

        // Progress bar animations (reuse pattern from user panel)
        document.querySelectorAll('.ca-progress-bar[data-width]').forEach(function (bar) {
            var w = parseInt(bar.dataset.width, 10);
            setTimeout(function () {
                bar.style.transition = 'width 0.8s ease';
                bar.style.width      = w + '%';
            }, 200);
        });

        // Counter animations
        document.querySelectorAll('[data-count]').forEach(function (el) {
            var target  = parseInt(el.dataset.count, 10);
            var start   = 0;
            var dur     = 900;
            var step    = Math.ceil(target / (dur / 16));
            var timer   = setInterval(function () {
                start  += step;
                if (start >= target) { start = target; clearInterval(timer); }
                el.textContent = start.toLocaleString();
            }, 16);
        });
    }());
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
