<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="CyberArena — Capture The Flag Management Platform" />
    <title>@ViewData["Title"] — CyberArena</title>

    @* ── Preconnect for Google Fonts ───────────────────────── *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    @* ── Bootstrap 5 ──────────────────────────────────────── *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    @* ── Font Awesome 6 (CDN) ─────────────────────────────── *@
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
          integrity="sha512-Avb2QiuDEEvB4bZJYdft2mNjVShBftLdPG8FJ0V7irTLQ8Uo0qcPxh4Plq7G5tGm0rU+1SPhVotteLpBERwTkw=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    @* ── CyberArena Styles ─────────────────────────────────── *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cyber-arena.css" asp-append-version="true" />

    @* ── Per-page styles ──────────────────────────────────── *@
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="ca-app">

    @* ── Sidebar ──────────────────────────────────────────── *@
    @await Html.PartialAsync("_Sidebar")

    @* ── Page Wrapper ─────────────────────────────────────── *@
    <div class="d-flex flex-column" style="flex:1;min-width:0;">

        @* ── Topbar ───────────────────────────────────────── *@
        @await Html.PartialAsync("_Topbar")

        @* ── Main Content ─────────────────────────────────── *@
        <main class="ca-main" id="main-content" role="main">

            @* Demo mode banner *@
            @if (TempData["DemoMode"] != null)
            {
                <div class="alert alert-info ca-auto-dismiss mb-3 d-flex align-items-center gap-2" role="alert">
                    <i class="fas fa-circle-info fa-fw" aria-hidden="true"></i>
                    <span>
                        <strong>Demo Mode:</strong> Running with mock data.
                        Connect ASP.NET Core Identity to enable real authentication.
                    </span>
                </div>
            }

            @* Profile saved flash *@
            @if (TempData["ProfileSaved"] != null)
            {
                <div class="alert alert-success ca-auto-dismiss mb-3 d-flex align-items-center gap-2" role="alert">
                    <i class="fas fa-circle-check fa-fw" aria-hidden="true"></i>
                    <span>Profile updated successfully.</span>
                </div>
            }

            @* Password changed flash *@
            @if (TempData["PasswordChanged"] != null)
            {
                <div class="alert alert-success ca-auto-dismiss mb-3 d-flex align-items-center gap-2" role="alert">
                    <i class="fas fa-circle-check fa-fw" aria-hidden="true"></i>
                    <span>Password changed successfully.</span>
                </div>
            }

            @* Admin action flash *@
            @if (TempData["AdminSuccess"] != null)
            {
                <div class="alert alert-success ca-auto-dismiss mb-3 d-flex align-items-center gap-2" role="alert">
                    <i class="fas fa-circle-check fa-fw" aria-hidden="true"></i>
                    <span>@TempData["AdminSuccess"]</span>
                </div>
            }

            @RenderBody()
        </main>

    </div>

    @* ── Scripts ──────────────────────────────────────────── *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/cyber-arena.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
