<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="CyberArenaWebForms.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="CyberArena — Capture The Flag Management Platform" />
    <title>
        <asp:ContentPlaceHolder ID="TitleContent" runat="server">CyberArena</asp:ContentPlaceHolder>
        &#8212; CyberArena
    </title>

    <!-- ── Google Fonts Preconnect ───────────────────────────── -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap"
          rel="stylesheet" />

    <!-- ── Bootstrap 5 ──────────────────────────────────────── -->
    <link rel="stylesheet" href="<%= ResolveUrl("~/lib/bootstrap/dist/css/bootstrap.min.css") %>" />

    <!-- ── Font Awesome 6 ───────────────────────────────────── -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
          integrity="sha512-Avb2QiuDEEvB4bZJYdft2mNjVShBftLdPG8FJ0V7irTLQ8Uo0qcPxh4Plq7G5tGm0rU+1SPhVotteLpBERwTkw=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- ── CyberArena Core Styles ────────────────────────────── -->
    <link rel="stylesheet" href="<%= ResolveUrl("~/CSS/site.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/CSS/cyber-arena.css") %>" />

    <!-- ── Per-page extra styles ────────────────────────────── -->
    <asp:ContentPlaceHolder ID="HeadStyles" runat="server" />
</head>
<body class="ca-app">

    <form id="MainForm" runat="server">

    <!-- ══════════════════════════════════════════════════════════
         SIDEBAR
    ══════════════════════════════════════════════════════════ -->
    <aside class="ca-sidebar" id="ca-sidebar" aria-label="Main navigation">

        <!-- Brand -->
        <a class="ca-sidebar-brand" href="<%= ResolveUrl("~/Dashboard/Dashboard.aspx") %>"
           aria-label="CyberArena home">
            <div class="ca-brand-icon" aria-hidden="true">
                <i class="fas fa-shield-halved"></i>
            </div>
            <div class="ca-brand-text">
                <span class="ca-brand-name">CyberArena</span>
                <span class="ca-brand-tagline">CTF Platform</span>
            </div>
        </a>

        <!-- Navigation -->
        <nav class="ca-sidebar-nav" aria-label="Primary navigation">
            <ul class="list-unstyled mb-0">

                <li class="ca-nav-section-label">Main</li>

                <li class="ca-nav-item">
                    <a class="ca-nav-link <%= IsActive("Dashboard") %>"
                       href="<%= ResolveUrl("~/Dashboard/Dashboard.aspx") %>"
                       id="nav-dashboard">
                        <span class="ca-nav-icon" aria-hidden="true"><i class="fas fa-gauge-high"></i></span>
                        Dashboard
                    </a>
                </li>

                <li class="ca-nav-item">
                    <a class="ca-nav-link <%= IsActive("Challenges") %>"
                       href="<%= ResolveUrl("~/Challenges/Challenges.aspx") %>"
                       id="nav-challenges">
                        <span class="ca-nav-icon" aria-hidden="true"><i class="fas fa-flag"></i></span>
                        Challenges
                        <span class="ca-nav-badge">24</span>
                    </a>
                </li>

                <li class="ca-nav-item">
                    <a class="ca-nav-link <%= IsActive("Leaderboard") %>"
                       href="<%= ResolveUrl("~/Leaderboard/Leaderboard.aspx") %>"
                       id="nav-leaderboard">
                        <span class="ca-nav-icon" aria-hidden="true"><i class="fas fa-trophy"></i></span>
                        Leaderboard
                    </a>
                </li>

                <li class="ca-nav-section-label">Social</li>

                <li class="ca-nav-item">
                    <a class="ca-nav-link <%= IsActive("Teams") %>"
                       href="<%= ResolveUrl("~/Teams/Teams.aspx") %>"
                       id="nav-teams">
                        <span class="ca-nav-icon" aria-hidden="true"><i class="fas fa-users"></i></span>
                        Teams
                    </a>
                </li>

                <li class="ca-nav-item">
                    <a class="ca-nav-link <%= IsActive("Competitions") %>"
                       href="<%= ResolveUrl("~/Competitions/Competitions.aspx") %>"
                       id="nav-competitions">
                        <span class="ca-nav-icon" aria-hidden="true"><i class="fas fa-bolt"></i></span>
                        Competitions
                    </a>
                </li>

                <li class="ca-nav-item">
                    <a class="ca-nav-link <%= IsActive("Announcements") %>"
                       href="<%= ResolveUrl("~/Announcements/Announcements.aspx") %>"
                       id="nav-announcements">
                        <span class="ca-nav-icon" aria-hidden="true"><i class="fas fa-bullhorn"></i></span>
                        Announcements
                    </a>
                </li>

                <li class="ca-nav-section-label">Account</li>

                <li class="ca-nav-item">
                    <a class="ca-nav-link <%= IsActive("Profile") %>"
                       href="<%= ResolveUrl("~/Account/Profile.aspx") %>"
                       id="nav-profile">
                        <span class="ca-nav-icon" aria-hidden="true"><i class="fas fa-circle-user"></i></span>
                        My Profile
                    </a>
                </li>

                <li class="ca-nav-item">
                    <a class="ca-nav-link text-danger" href="#"
                       onclick="document.getElementById('logout-form').submit(); return false;"
                       id="nav-logout">
                        <span class="ca-nav-icon" aria-hidden="true"><i class="fas fa-right-from-bracket"></i></span>
                        Sign Out
                    </a>
                </li>

            </ul>
        </nav>

        <!-- Sidebar footer: user chip -->
        <div class="ca-sidebar-footer">
            <a class="ca-user-mini" href="<%= ResolveUrl("~/Account/Profile.aspx") %>"
               aria-label="View your profile">
                <div class="ca-user-avatar-sm" aria-hidden="true">
                    <%= GetUserInitials() %>
                </div>
                <div class="ca-user-info">
                    <div class="ca-user-name"><%= GetUsername() %></div>
                    <div class="ca-user-role">Participant</div>
                </div>
            </a>
        </div>

    </aside>

    <!-- ══════════════════════════════════════════════════════════
         PAGE WRAPPER (topbar + main content)
    ══════════════════════════════════════════════════════════ -->
    <div class="d-flex flex-column" style="flex:1;min-width:0;">

        <!-- ── Topbar ─────────────────────────────────────────── -->
        <header class="ca-topbar" role="banner">

            <div class="ca-topbar-left">
                <!-- Mobile sidebar toggle -->
                <button class="ca-sidebar-toggle"
                        id="ca-sidebar-toggle"
                        type="button"
                        aria-controls="ca-sidebar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <i class="fas fa-bars" aria-hidden="true"></i>
                </button>

                <!-- Page title (set per-page via PageTitle property) -->
                <div>
                    <h1 class="ca-page-title">
                        <asp:Literal ID="litPageTitle" runat="server" Text="CyberArena" />
                    </h1>
                    <!-- Breadcrumb (shown only when set) -->
                    <nav id="breadcrumb-nav" class="ca-breadcrumb" aria-label="breadcrumb"
                         runat="server" visible="false">
                        <a href="<%= ResolveUrl("~/Dashboard/Dashboard.aspx") %>">Home</a>
                        <span class="ca-breadcrumb-sep" aria-hidden="true">/</span>
                        <span class="ca-breadcrumb-current">
                            <asp:Literal ID="litBreadcrumb" runat="server" />
                        </span>
                    </nav>
                </div>
            </div>

            <div class="ca-topbar-right" role="toolbar" aria-label="User actions">

                <!-- Search shortcut -->
                <a class="ca-icon-btn" href="#"
                   id="topbar-search"
                   data-bs-toggle="tooltip"
                   data-bs-placement="bottom"
                   title="Search (Ctrl+K)"
                   aria-label="Search">
                    <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                </a>

                <!-- Notifications -->
                <a class="ca-icon-btn" href="#"
                   id="topbar-notifications"
                   data-bs-toggle="tooltip"
                   data-bs-placement="bottom"
                   title="Notifications"
                   aria-label="Notifications (3 unread)">
                    <i class="fas fa-bell" aria-hidden="true"></i>
                    <span class="ca-notif-dot" aria-label="3 unread notifications"></span>
                </a>

                <!-- Profile avatar dropdown -->
                <div class="dropdown">
                    <button class="ca-icon-btn p-0"
                            id="topbar-user-dropdown"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            aria-label="User menu"
                            style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#3B82F6,#6366F1);color:#fff;font-weight:700;font-size:0.82rem;border:2px solid rgba(59,130,246,0.4);">
                        <%= GetUserInitials() %>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow"
                        aria-labelledby="topbar-user-dropdown"
                        style="background:var(--ca-bg-card);border-color:var(--ca-border);min-width:190px;">
                        <li>
                            <div class="px-3 py-2 border-bottom" style="border-color:var(--ca-border)!important;">
                                <div style="font-size:0.875rem;font-weight:600;color:var(--ca-text-primary);"><%= GetUsername() %></div>
                                <div style="font-size:0.75rem;color:var(--ca-text-muted);"><%= GetUserEmail() %></div>
                            </div>
                        </li>
                        <li>
                            <a class="dropdown-item"
                               href="<%= ResolveUrl("~/Account/Profile.aspx") %>"
                               style="color:var(--ca-text-secondary);font-size:0.875rem;">
                                <i class="fas fa-circle-user me-2" style="color:var(--ca-accent);"></i>Profile
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="#"
                               style="color:var(--ca-text-secondary);font-size:0.875rem;">
                                <i class="fas fa-gear me-2" style="color:var(--ca-text-muted);"></i>Settings
                            </a>
                        </li>
                        <li><hr class="dropdown-divider" style="border-color:var(--ca-border);"></li>
                        <li>
                            <a class="dropdown-item text-danger" href="#"
                               onclick="document.getElementById('logout-form').submit(); return false;"
                               style="font-size:0.875rem;">
                                <i class="fas fa-right-from-bracket me-2"></i>Sign Out
                            </a>
                        </li>
                    </ul>
                </div>

            </div>
        </header>

        <!-- ── Main Content ──────────────────────────────────── -->
        <main class="ca-main" id="main-content" role="main">

            <!-- Flash: Demo Mode banner -->
            <asp:Panel ID="pnlDemoMode" runat="server" Visible="false"
                       CssClass="alert alert-info ca-auto-dismiss mb-3 d-flex align-items-center gap-2"
                       role="alert">
                <i class="fas fa-circle-info fa-fw" aria-hidden="true"></i>
                <span>
                    <strong>Demo Mode:</strong> Running with mock data.
                    Connect a database to enable real authentication.
                </span>
            </asp:Panel>

            <!-- Flash: Profile saved -->
            <asp:Panel ID="pnlProfileSaved" runat="server" Visible="false"
                       CssClass="alert alert-success ca-auto-dismiss mb-3 d-flex align-items-center gap-2"
                       role="alert">
                <i class="fas fa-circle-check fa-fw" aria-hidden="true"></i>
                <span>Profile updated successfully.</span>
            </asp:Panel>

            <!-- Flash: Password changed -->
            <asp:Panel ID="pnlPasswordChanged" runat="server" Visible="false"
                       CssClass="alert alert-success ca-auto-dismiss mb-3 d-flex align-items-center gap-2"
                       role="alert">
                <i class="fas fa-circle-check fa-fw" aria-hidden="true"></i>
                <span>Password changed successfully.</span>
            </asp:Panel>

            <!-- Flash: General success (replaces TempData["AdminSuccess"]) -->
            <asp:Panel ID="pnlSuccess" runat="server" Visible="false"
                       CssClass="alert alert-success ca-auto-dismiss mb-3 d-flex align-items-center gap-2"
                       role="alert">
                <i class="fas fa-circle-check fa-fw" aria-hidden="true"></i>
                <asp:Literal ID="litSuccess" runat="server" />
            </asp:Panel>

            <!-- ═══ PAGE-SPECIFIC CONTENT ═══ -->
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />

        </main>

    </div>

    <!-- ── Hidden logout form (no MVC post needed) ────────────── -->
    <asp:Panel ID="pnlLogoutForm" runat="server">
        <form id="logout-form" action="<%= ResolveUrl("~/Account/Login.aspx") %>"
              method="post" style="display:none;">
            <asp:HiddenField ID="hdnLogoutAction" runat="server" Value="logout" />
        </form>
    </asp:Panel>

    <!-- Mobile overlay -->
    <div class="ca-sidebar-overlay" id="ca-sidebar-overlay" aria-hidden="true"></div>

    </form>

    <!-- ── Scripts ──────────────────────────────────────────── -->
    <script src="<%= ResolveUrl("~/lib/jquery/dist/jquery.min.js") %>"></script>
    <script src="<%= ResolveUrl("~/lib/bootstrap/dist/js/bootstrap.bundle.min.js") %>"></script>
    <script src="<%= ResolveUrl("~/JS/cyber-arena.js") %>"></script>

    <!-- Per-page scripts -->
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />

</body>
</html>
